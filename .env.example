# Copy this file to .env and fill in real values.
# Never commit .env. Never put the service_role key in HTML or JS in the browser.

PORT=3000

# From Supabase: Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# From Supabase: Project Settings → API → service_role
# This key bypasses Row Level Security. Server only.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# The website that is allowed to call this API (CORS).
# Local example: http://127.0.0.1:5500
# Live example: https://your-site.onrender.com
ALLOWED_ORIGIN=http://127.0.0.1:5500

# Optional. Only set this if your scores and guestbook rows have a project_id column.
# PROJECT_ID=
